# คัดลอกเป็น .env แล้ว chmod 600 — ห้าม commit
DATABASE_URL=postgres://ledger:changeme@127.0.0.1:5432/ledger
POSTGRES_PASSWORD=changeme

# 32 ไบต์ = 64 ตัวอักษร hex : openssl rand -hex 32
# คีย์เดียวใช้ทั้ง refresh token ของ Google และรหัสผ่าน PDF
# เก็บสำเนาไว้ใน password manager นอกเครื่องด้วย — คีย์หายคือถอดข้อมูลเก่าไม่ได้เลย
ENCRYPTION_KEY=

# openssl rand -hex 32
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=

# Google Cloud Console → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI ต้องเป็น <BASE_URL>/auth/google/callback
# ห้ามใส่ scope `drive` เด็ดขาด
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BASE_URL=http://localhost:5173
PORT=3000

# อีเมลนี้ล็อกอินครั้งแรกจะได้ is_admin + approved อัตโนมัติ
ADMIN_EMAIL=

# ที่เก็บ PDF ต้นฉบับ (ยังเข้ารหัสอยู่)
PDF_STORAGE_DIR=./data/pdf

# ที่เก็บเอกสารภาษี — เข้ารหัสด้วย ENCRYPTION_KEY เดียวกันก่อนลงดิสก์เสมอ (ต่างจาก data/pdf ที่พึ่ง
# รหัสผ่าน PDF ของธนาคารเอง เอกสารภาษีมาเป็น plaintext จึงต้องเข้ารหัสเอง — §10.4)
TAX_DOC_STORAGE_DIR=./data/tax-docs
